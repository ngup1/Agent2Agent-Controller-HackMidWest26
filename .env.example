# Synthetic local settings. Compose uses db; host Python uses localhost.
DATABASE_URL=postgresql://demo:demo@db:5432/demo
DEMO_BUSINESS_ID=6a33f197-7784-54dd-84db-f40dce4c8733

# Managed database (SSA-021): change DATABASE_URL only, percent-encode password.
# postgresql://akmadmin:ENCODED_PASSWORD@HOST:PORT/defaultdb?sslmode=require

# Workshop names retained. Startup, migrations, seed and tests need no API key.
OPENAI_BASE_URL=https://ws.akamai-workshops.com/v1
OPENAI_API_KEY=
CHAT_MODEL=hackathon-chat
EMBEDDING_MODEL=hackathon-embedding

# Gate providers (SSA-010): fake, live, or unset. Unset or failing providers send
# every bookable request to staff review. Fake results are labelled as fake.
RETRIEVAL_MODE=fake
JEV_MODE=fake
PRECEDENT_SIMILARITY_MIN=0.80

# Jev through the TypeSafe SDK (SSA-009). JEV_MODE=live needs the key; without it
# the gate escalates. Leave TYPESAFE_MODEL empty for the SDK default (jev-latest).
TYPESAFE_API_KEY=
TYPESAFE_MODEL=
